{
  // Cloudflare Worker 配置：静态资源 + 管理后台 API（worker.js）
  // push 后由 Workers Builds 自动执行 `npx wrangler deploy` 部署
  "name": "blog",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    // 站点就是仓库根目录：index.html / admin.html / assets/ / posts/ / posts.json
    // 哪些文件不作为静态资源上传，看同目录的 .assetsignore
    "directory": "./",
    "binding": "ASSETS",
    // /api/* 永远先进 Worker（管理后台接口），其余路径静态资源优先
    "run_worker_first": ["/api/*"]
  }
}
